        <mxCell id="20" value="&lt;b&gt;Preprocessing (price only)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font size='2'&gt;arcsinh transformation · MSTL decomposition (24h + 168h + 8760h)&lt;br&gt;Sliding windows: 512 hours context, 6 hours stride → 7,217 windows&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=10;" vertex="1" parent="1">
